# Copy to .env (never commit it). See README.md for what each value is.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/goldplatform
SECRET_KEY=            # python -c "import secrets;print(secrets.token_urlsafe(64))"
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false    # true in production (HTTPS)
SESSION_HOURS=8
REMEMBER_DAYS=30
AUTO_CREATE_TABLES=true
SEED_DEMO=false
ADMIN_EMAIL=
ADMIN_PASSWORD=        # at least 10 characters including a special character

GEMINI_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
COHERE_MODEL=command-r-08-2024

# Password-reset delivery (optional until you are ready)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
AT_USERNAME=
AT_API_KEY=
AT_SENDER=

SUPPORT_EMAIL=
SUPPORT_PHONE=
